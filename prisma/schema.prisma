// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  mbti      String?  // e.g. "INTJ"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationships Relationship[]
  actionLogs    ActionLog[]
}

model Relationship {
  id                String   @id @default(uuid())
  userId            String
  name              String
  relationType      String   // e.g. "Partner", "Mother", "Friend"
  mbti              String?  
  behavioralProfile String?  // JSON string storing observer profiling answers
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionLogs ActionLog[]
}

model Scenario {
  id           String   @id @default(uuid())
  name         String   // e.g. "如何劝 TA 戒掉某个坏习惯"
  systemPrompt String   // Prompt template for LLM
  relationType String?  // null means applies to all, otherwise specific e.g. "Partner"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actionLogs ActionLog[]
}

model ActionLog {
  id             String   @id @default(uuid())
  userId         String
  relationshipId String
  scenarioId     String
  adviceGiven    String
  feedbackStatus Int?     // 1 for 👍, -1 for 👎, null for unrated
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  scenario     Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}
